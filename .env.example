# utiligo-api base URL. Locally, use the port your utiligo-api runs on (5000 by
# default); in production, the deployed API. The landing page falls back to the
# production API when this is unset.
NEXT_PUBLIC_UTILIGO_API_BASE_URL=http://localhost:5000

# Firebase (client) — same project as utiligo-app / utiligo-admin
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
